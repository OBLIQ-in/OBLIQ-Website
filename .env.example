# Analytics (optional) — leave unset to ship without any tracking.
# The domain as registered in Plausible: a bare hostname, e.g. obliq.in
# (comma-separate several for roll-ups). Invalid values disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# https:// script URL; only needed for a self-hosted Plausible CE instance.
# Its origin is added to the Content-Security-Policy automatically.
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Contact / join-our-team form (optional) — the full Formspree endpoint, e.g.
# https://formspree.io/f/abcdwxyz. Server-only: do NOT prefix with NEXT_PUBLIC_.
# Leave unset and the form will show an error when someone submits.
FORMSPREE_ENDPOINT=
